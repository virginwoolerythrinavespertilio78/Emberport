<UserControl x:Class="Emberport.Controls.MySqlBackupCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFontFamily}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <Style x:Key="BackupCheckStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Shell"
                                Padding="14,12"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="#121215"
                                BorderBrush="#33333C"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Box"
                                        Grid.Column="0"
                                        Width="20"
                                        Height="20"
                                        CornerRadius="4"
                                        Background="#1A1A1F"
                                        BorderBrush="#33333C"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Tick"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="#FF8340"
                                               Visibility="Collapsed"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#1A1A1F" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#14FF6B1A" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#4DFF6B1A" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#4DFF6B1A" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackupBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#121215"
                                BorderBrush="#33333C"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="4"
                                        Background="{StaticResource EmberGradientBrush}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Padding="20,18"
            CornerRadius="{StaticResource RadiusMd}"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1">
        <StackPanel>

            <TextBlock Text="Backup"
                       FontSize="{StaticResource FontSizeHeading}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />

            <TextBlock Margin="0,9,0,0"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource FontSizeBody}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Dumps every database, including routines, triggers and events, while the server keeps serving. The dump is streamed to disk, so database size is not a limit." />

            <TextBlock Text="Destination folder"
                       Margin="0,18,0,0"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextTertiaryBrush}" />

            <Border Margin="0,7,0,0"
                    Padding="13,11"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="#121215"
                    BorderBrush="#33333C"
                    BorderThickness="1">
                <TextBlock x:Name="FolderText"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="12"
                           Foreground="#FF8340"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <CheckBox x:Name="CompressCheck"
                      Margin="0,14,0,0"
                      HorizontalAlignment="Left"
                      IsChecked="True"
                      Style="{StaticResource BackupCheckStyle}"
                      Content="Compress while writing (.sql.gz)" />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button x:Name="BackupButton"
                        Content="Back up now"
                        MinWidth="132"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnBackupClick" />
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        MinWidth="96"
                        Margin="9,0,0,0"
                        IsEnabled="False"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnCancelClick" />
                <Button x:Name="ChangeFolderButton"
                        Content="Change folder"
                        MinWidth="126"
                        Margin="9,0,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnChangeFolderClick" />
                <Button x:Name="OpenFolderButton"
                        Content="Open folder"
                        MinWidth="112"
                        Margin="9,0,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnOpenFolderClick" />
            </StackPanel>

            <ProgressBar x:Name="Bar"
                         Margin="0,18,0,0"
                         Visibility="Collapsed"
                         Style="{StaticResource BackupBarStyle}" />

            <TextBlock x:Name="ProgressText"
                       Margin="0,10,0,0"
                       Visibility="Collapsed"
                       FontFamily="{StaticResource MonoFontFamily}"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <TextBlock x:Name="StatusText"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource TextTertiaryBrush}" />

        </StackPanel>
    </Border>
</UserControl>