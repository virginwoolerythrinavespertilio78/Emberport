<Window x:Class="Emberport.Controls.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Emberport.Services"
        Width="292"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource UiFontFamily}"
        Loaded="OnLoaded"
        Closed="OnClosed"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <Style x:Key="TrayItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#1A1A1F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#26262D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="TrayLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="TrayStateStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        </Style>

        <Style x:Key="TrayDotStyle" TargetType="Border">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#5A5A63" />
        </Style>

        <Style x:Key="TraySectionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="12,6,0,4" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the drop shadow. -->
    <Border Margin="14"
            Padding="8"
            CornerRadius="{StaticResource RadiusLg}"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <StackPanel>

            <!-- Header -->
            <Grid Margin="6,6,6,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="32"
                        Height="32"
                        Padding="5"
                        CornerRadius="{StaticResource RadiusSm}"
                        Background="#121215"
                        BorderBrush="#33333C"
                        BorderThickness="1">
                    <Image Source="/Assets/logo.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Emberport"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{x:Static services:AppInfo.DisplayVersion}"
                               Margin="0,2,0,0"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <Border Height="1" Margin="4,0,4,4" Background="{StaticResource BorderSubtleBrush}" />

            <!-- Services -->
            <TextBlock Style="{StaticResource TraySectionStyle}" Text="SERVICES" />

            <Button Style="{StaticResource TrayItemStyle}" Click="OnApacheClick" ToolTip="Start or stop Apache">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource TrayGlyphStyle}" Text="&#xE774;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource TrayLabelStyle}" Text="Apache" />
                    <TextBlock x:Name="ApacheState" Grid.Column="2" Style="{StaticResource TrayStateStyle}" />
                    <Border x:Name="ApacheDot" Grid.Column="3" Style="{StaticResource TrayDotStyle}" />
                </Grid>
            </Button>

            <Button Style="{StaticResource TrayItemStyle}" Click="OnMySqlClick" ToolTip="Start or stop MySQL">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource TrayGlyphStyle}" Text="&#xE8F1;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource TrayLabelStyle}" Text="MySQL" />
                    <TextBlock x:Name="MySqlState" Grid.Column="2" Style="{StaticResource TrayStateStyle}" />
                    <Border x:Name="MySqlDot" Grid.Column="3" Style="{StaticResource TrayDotStyle}" />
                </Grid>
            </Button>

            <Button Style="{StaticResource TrayItemStyle}" Click="OnRedisClick" ToolTip="Start or stop Redis">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource TrayGlyphStyle}" Text="&#xE945;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource TrayLabelStyle}" Text="Redis" />
                    <TextBlock x:Name="RedisState" Grid.Column="2" Style="{StaticResource TrayStateStyle}" />
                    <Border x:Name="RedisDot" Grid.Column="3" Style="{StaticResource TrayDotStyle}" />
                </Grid>
            </Button>

            <Border Height="1" Margin="4,8,4,4" Background="{StaticResource BorderSubtleBrush}" />

            <!-- Shortcuts -->
            <Button Style="{StaticResource TrayItemStyle}" Click="OnOpenAppClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TrayGlyphStyle}" Text="&#xE7C4;" />
                    <TextBlock Style="{StaticResource TrayLabelStyle}" Text="Open Emberport" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource TrayItemStyle}" Click="OnLocalhostClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TrayGlyphStyle}" Text="&#xE774;" />
                    <TextBlock x:Name="LocalhostLabel" Style="{StaticResource TrayLabelStyle}" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource TrayItemStyle}" Click="OnPhpMyAdminClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TrayGlyphStyle}" Text="&#xE8F1;" />
                    <TextBlock Style="{StaticResource TrayLabelStyle}" Text="Open phpMyAdmin" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource TrayItemStyle}" Click="OnWebRootClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TrayGlyphStyle}" Text="&#xE8B7;" />
                    <TextBlock Style="{StaticResource TrayLabelStyle}" Text="Open web root" />
                </StackPanel>
            </Button>

            <Border Height="1" Margin="4,8,4,4" Background="{StaticResource BorderSubtleBrush}" />

            <Button Style="{StaticResource TrayItemStyle}" Click="OnExitClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TrayGlyphStyle}" Text="&#xE7E8;" Foreground="#F87171" />
                    <TextBlock Style="{StaticResource TrayLabelStyle}" Text="Exit Emberport" Foreground="#F87171" />
                </StackPanel>
            </Button>

            <TextBlock Margin="12,6,8,4"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       Text="Click a service to start or stop it. Exit stops them all." />

        </StackPanel>
    </Border>
</Window>