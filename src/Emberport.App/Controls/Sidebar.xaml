<UserControl
    x:Class="Emberport.Controls.Sidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="240">

    <Border
        Background="{StaticResource SurfaceRaisedBrush}"
        BorderBrush="{StaticResource BorderSubtleBrush}"
        BorderThickness="0,0,1,0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                Grid.Row="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,8,0,16">

                    <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="OVERVIEW" />

                    <RadioButton
                        Content="Dashboard"
                        IsChecked="True"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE80F;" />

                    <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="SERVICES" />

                    <RadioButton
                        Content="Apache"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE774;" />
                    <RadioButton
                        Content="MySQL"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE8F1;" />
                    <RadioButton
                        Content="Redis"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE945;" />

                    <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="WORKSPACE" />

                    <RadioButton
                        Content="PHP"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE943;" />
                    <RadioButton
                        Content="Sites"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE8B7;" />
                    <RadioButton
                        Content="Logs"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE7C3;" />

                    <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="SYSTEM" />

                    <RadioButton
                        Content="Settings"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE713;" />
                    <RadioButton
                        Content="About"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE946;" />

                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.Row="1"
                Padding="18,12"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="Emberport v0.1.0" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="by Hojjat Jahanpour" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>