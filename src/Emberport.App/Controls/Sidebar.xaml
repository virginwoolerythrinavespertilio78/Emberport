<UserControl
    x:Class="Emberport.Controls.Sidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="240">

    <Border
        Background="{StaticResource SurfaceRaisedBrush}"
        BorderBrush="{StaticResource BorderSubtleBrush}"
        BorderThickness="0,0,1,0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                Grid.Row="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,8,0,16">

                    <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="OVERVIEW" />

                    <RadioButton
                        x:Uid="dashboard"
                        Checked="OnNavItemChecked"
                        Content="Dashboard"
                        IsChecked="True"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE80F;" />

                    <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="SERVICES" />

                    <RadioButton
                        x:Uid="apache"
                        Checked="OnNavItemChecked"
                        Content="Apache"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE774;" />
                    <RadioButton
                        x:Uid="mysql"
                        Checked="OnNavItemChecked"
                        Content="MySQL"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE8F1;" />
                    <RadioButton
                        x:Uid="redis"
                        Checked="OnNavItemChecked"
                        Content="Redis"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE945;" />

                    <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="WORKSPACE" />

                    <RadioButton
                        x:Uid="php"
                        Checked="OnNavItemChecked"
                        Content="PHP"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE943;" />
                    <RadioButton
                        x:Uid="sites"
                        Checked="OnNavItemChecked"
                        Content="Web Root"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE8B7;" />
                    <RadioButton
                        x:Uid="terminal"
                        Checked="OnNavItemChecked"
                        Content="Terminal"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE756;" />
                    <RadioButton
                        x:Uid="logs"
                        Checked="OnNavItemChecked"
                        Content="Logs"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE7C3;" />

                    <TextBlock Style="{StaticResource NavSectionLabelStyle}" Text="SYSTEM" />

                    <RadioButton
                        x:Uid="settings"
                        Checked="OnNavItemChecked"
                        Content="Settings"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE713;" />
                    <RadioButton
                        x:Uid="about"
                        Checked="OnNavItemChecked"
                        Content="About"
                        Style="{StaticResource NavItemStyle}"
                        Tag="&#xE946;" />

                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.Row="1"
                Padding="18,12"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="Emberport v0.4.0" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="by Hojjat Jahanpour" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>