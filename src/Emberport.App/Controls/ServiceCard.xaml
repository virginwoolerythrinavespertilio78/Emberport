<UserControl
    x:Class="Emberport.Controls.ServiceCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="44"
                Height="44"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceOverlayBrush}"
                CornerRadius="{StaticResource RadiusSm}">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="18"
                    Foreground="{StaticResource EmberBrush}"
                    Text="{Binding Glyph, ElementName=Root}" />
            </Border>

            <StackPanel
                Grid.Column="1"
                Margin="14,0,14,0"
                VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="{StaticResource FontSizeHeading}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{Binding Title, ElementName=Root}" />

                    <Border
                        Margin="10,0,0,0"
                        Padding="7,2"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceOverlayBrush}"
                        CornerRadius="{StaticResource RadiusPill}">
                        <TextBlock
                            FontSize="{StaticResource FontSizeCaption}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{Binding Version, ElementName=Root}" />
                    </Border>
                </StackPanel>

                <TextBlock
                    Margin="0,5,0,0"
                    FontFamily="{StaticResource MonoFontFamily}"
                    FontSize="{StaticResource FontSizeCaption}"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="{Binding Detail, ElementName=Root}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <StackPanel Margin="0,0,16,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse
                        x:Name="StatusDot"
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{StaticResource StatusStoppedBrush}" />
                    <TextBlock
                        x:Name="StatusLabel"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Stopped" />
                </StackPanel>

                <Button
                    x:Name="StartButton"
                    Click="OnStartClick"
                    Content="Start"
                    Style="{StaticResource PrimaryButtonStyle}" />

                <Button
                    x:Name="StopButton"
                    Margin="8,0,0,0"
                    Click="OnStopClick"
                    Content="Stop"
                    Style="{StaticResource GhostButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>