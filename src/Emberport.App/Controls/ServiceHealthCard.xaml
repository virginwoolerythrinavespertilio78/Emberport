<UserControl x:Class="Emberport.Controls.ServiceHealthCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFontFamily}">

    <Border Padding="20,18"
            CornerRadius="{StaticResource RadiusMd}"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1">
        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Health check"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="Subtitle"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                    <Button Content="Run checks"
                            MinWidth="120"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OnRunClick" />
                    <Button Content="Clean up"
                            MinWidth="112"
                            Margin="9,0,0,0"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="OnCleanUpClick" />
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="FindingList" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10"
                                Padding="16,14"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="#121215"
                                BorderBrush="{Binding BorderColor}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="8"
                                        Height="8"
                                        Margin="0,6,12,0"
                                        VerticalAlignment="Top"
                                        CornerRadius="4"
                                        Background="{Binding DotColor}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="SummaryText"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource TextTertiaryBrush}" />
        </StackPanel>
    </Border>
</UserControl>