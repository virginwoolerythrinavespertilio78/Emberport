<Window
    x:Class="Emberport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Emberport.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Emberport"
    Width="1100"
    Height="700"
    MinWidth="900"
    MinHeight="600"
    Background="Transparent"
    FontFamily="{StaticResource UiFontFamily}"
    Foreground="{StaticResource TextPrimaryBrush}"
    WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="48"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border
        x:Name="RootBorder"
        Background="{StaticResource SurfaceBaseBrush}"
        BorderBrush="{StaticResource BorderSubtleBrush}"
        BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <!-- Compensates for the invisible resize frame when maximized -->
                        <Setter Property="Margin" Value="7" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:TitleBar Grid.Row="0" Loaded="TitleBar_Loaded" />

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource FontSizeDisplay}"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource EmberGradientBrush}"
                    Text="Emberport" />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource FontSizeCaption}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="DEPLOY. MANAGE. IGNITE." />
            </StackPanel>
        </Grid>
    </Border>
</Window>