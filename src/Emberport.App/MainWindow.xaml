<Window
    x:Class="Emberport.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Emberport"
    Width="1100"
    Height="700"
    Background="{StaticResource SurfaceBaseBrush}"
    FontFamily="{StaticResource UiFontFamily}"
    Foreground="{StaticResource TextPrimaryBrush}">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock
            Text="Emberport"
            FontSize="{StaticResource FontSizeDisplay}"
            FontWeight="SemiBold"
            Foreground="{StaticResource EmberGradientBrush}"
            HorizontalAlignment="Center" />
        <TextBlock
            Text="DEPLOY. MANAGE. IGNITE."
            FontSize="{StaticResource FontSizeCaption}"
            Foreground="{StaticResource TextSecondaryBrush}"
            Margin="0,8,0,0"
            HorizontalAlignment="Center" />
    </StackPanel>
</Window>