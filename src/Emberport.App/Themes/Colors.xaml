<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces: from deepest background to highest elevation -->
    <Color x:Key="SurfaceBaseColor">#0E0E10</Color>
    <Color x:Key="SurfaceRaisedColor">#16161A</Color>
    <Color x:Key="SurfaceOverlayColor">#1C1C21</Color>
    <Color x:Key="SurfaceHoverColor">#26262D</Color>

    <!-- Borders -->
    <Color x:Key="BorderSubtleColor">#232329</Color>
    <Color x:Key="BorderStrongColor">#33333C</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F2F2F5</Color>
    <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
    <Color x:Key="TextTertiaryColor">#6E6E78</Color>

    <!-- Ember accent: the brand signature -->
    <Color x:Key="EmberColor">#FF6B1A</Color>
    <Color x:Key="EmberHoverColor">#FF8340</Color>
    <Color x:Key="EmberPressedColor">#E0550C</Color>
    <Color x:Key="EmberDeepColor">#C2410C</Color>

    <!-- Status -->
    <Color x:Key="StatusRunningColor">#3DD68C</Color>
    <Color x:Key="StatusWarningColor">#FBBF24</Color>
    <Color x:Key="StatusStoppedColor">#5A5A63</Color>
    <Color x:Key="StatusErrorColor">#F87171</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource SurfaceBaseColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="{StaticResource SurfaceOverlayColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

    <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource EmberColor}" />
    <SolidColorBrush x:Key="EmberHoverBrush" Color="{StaticResource EmberHoverColor}" />
    <SolidColorBrush x:Key="EmberPressedBrush" Color="{StaticResource EmberPressedColor}" />

    <SolidColorBrush x:Key="StatusRunningBrush" Color="{StaticResource StatusRunningColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="{StaticResource StatusStoppedColor}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />

    <!-- Signature ember gradient, taken from the logo -->
    <LinearGradientBrush x:Key="EmberGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource EmberHoverColor}" />
        <GradientStop Offset="1" Color="{StaticResource EmberDeepColor}" />
    </LinearGradientBrush>

</ResourceDictionary>