<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="NavItemStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="10,2,10,2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="MainNavigation" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border
                            x:Name="Background"
                            Background="Transparent"
                            CornerRadius="{StaticResource RadiusSm}" />

                        <!-- Ember indicator shown only for the active item -->
                        <Border
                            x:Name="Indicator"
                            Width="3"
                            Height="18"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource EmberBrush}"
                            CornerRadius="{StaticResource RadiusPill}"
                            Opacity="0" />

                        <StackPanel
                            Margin="16,0,12,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                x:Name="Icon"
                                Width="18"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Tag}" />
                            <ContentPresenter
                                Margin="12,0,0,0"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{StaticResource SurfaceOverlayBrush}" />
                            <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource EmberBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavSectionLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="26,18,0,6" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

</ResourceDictionary>