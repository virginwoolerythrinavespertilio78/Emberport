<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<!-- Needed only for the notification area icon, which WPF does not provide. -->
		<UseWindowsForms>true</UseWindowsForms>
		<!-- Without this, WinForms and WPF types such as UserControl and Brush clash everywhere. -->
		<DisableImplicitNamespaceImports_WindowsForms>true</DisableImplicitNamespaceImports_WindowsForms>
		<AssemblyName>Emberport</AssemblyName>
		<RootNamespace>Emberport</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.4.0</Version>
		<AssemblyVersion>0.4.0.0</AssemblyVersion>
		<FileVersion>0.4.0.0</FileVersion>
		<InformationalVersion>0.4.0</InformationalVersion>
		<Product>Emberport</Product>
		<Company>Hojjat Jahanpour</Company>
		<Authors>Hojjat Jahanpour</Authors>
		<Description>A modern local development environment for Windows: Apache, PHP, MySQL and Redis with one click.</Description>
	</PropertyGroup>

	<PropertyGroup Condition="Exists('Assets\logo.ico')">
		<ApplicationIcon>Assets\logo.ico</ApplicationIcon>
	</PropertyGroup>

	<!-- Belt and braces: drop the two global imports that cause the ambiguity. -->
	<ItemGroup>
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\logo.png" Condition="Exists('Assets\logo.png')" />
		<Resource Include="Assets\logo.ico" Condition="Exists('Assets\logo.ico')" />
	</ItemGroup>

</Project>