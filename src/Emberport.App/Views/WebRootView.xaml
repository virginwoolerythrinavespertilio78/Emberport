<UserControl x:Class="Emberport.Views.WebRootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,28,34,32">
        <StackPanel>

            <TextBlock Text="Web Root" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="The folder Apache serves. Keep the bundled one, or point it anywhere on any drive." />

            <Border Margin="0,24,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Current root"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <Border Margin="0,14,0,0"
                            Padding="13,11"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#121215"
                            BorderBrush="#33333C"
                            BorderThickness="1">
                        <TextBlock x:Name="RootPathText"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="#FF8340" />
                    </Border>

                    <TextBlock x:Name="RootBadge"
                               Margin="0,9,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />

                    <TextBlock x:Name="RootWarning"
                               Visibility="Collapsed"
                               Margin="0,9,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#F87171" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Change folder"
                                MinWidth="140"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnChangeRootClick" />
                        <Button x:Name="ResetRootButton"
                                Content="Use default www"
                                MinWidth="146"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnResetRootClick" />
                        <Button Content="Open folder"
                                MinWidth="126"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnOpenRootClick" />
                    </StackPanel>

                    <TextBlock x:Name="RootStatus"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Terminal"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Opens a command prompt in this folder with the Emberport binaries in front of the system PATH. Nothing on your machine is modified." />

                    <ItemsControl x:Name="PathList" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,7"
                                        Padding="12,9"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Background="#121215"
                                        BorderBrush="#33333C"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FF8340" />
                                        <TextBlock Text="{Binding DirectoryPath}"
                                                   Margin="0,3,0,0"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="PathEmpty"
                               Visibility="Collapsed"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#F87171"
                               Text="No binaries detected yet, so the shell opens with the plain system PATH." />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Open terminal"
                                MinWidth="140"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnOpenTerminalClick" />
                        <Button Content="Rescan binaries"
                                MinWidth="146"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnRescanClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="How it works"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Anything inside this folder is served straight away. A folder named shop answers at /shop/, and a file at the top level answers at the root address. Emberport never writes into a folder you chose yourself, so your projects stay exactly as you left them." />

                    <TextBlock Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Changing the root restarts Apache when it is running." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>