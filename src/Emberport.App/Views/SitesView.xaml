<UserControl x:Class="Emberport.Views.SitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFontFamily}">

    <UserControl.Resources>
        <Style x:Key="NameBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="#FF8340" />
            <Setter Property="SelectionBrush" Value="{StaticResource EmberBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Shell"
                                Padding="12,9"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="#121215"
                                BorderBrush="#33333C"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#4DFF6B1A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,28,34,32">
        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Sites" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="Every folder inside the server root is a project. Drop one in, or create it here." />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Rescan"
                        MinWidth="104"
                        Margin="16,4,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnRescanClick" />
            </Grid>

            <Border Margin="0,24,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Server root"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock Margin="0,7,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="The folder Apache serves. Point it at any drive to keep your projects wherever you like." />

                    <Border Margin="0,14,0,0"
                            Padding="13,11"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#121215"
                            BorderBrush="#33333C"
                            BorderThickness="1">
                        <TextBlock x:Name="RootPathText"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="#FF8340" />
                    </Border>

                    <TextBlock x:Name="RootWarning"
                               Visibility="Collapsed"
                               Margin="0,9,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#F87171" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Change folder"
                                MinWidth="140"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnChangeRootClick" />
                        <Button x:Name="ResetRootButton"
                                Content="Use default www"
                                MinWidth="146"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnResetRootClick" />
                        <Button Content="Open folder"
                                MinWidth="126"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnOpenRootClick" />
                    </StackPanel>

                    <TextBlock x:Name="RootStatus"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="New site"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="NameBox"
                                 Grid.Column="0"
                                 Style="{StaticResource NameBoxStyle}"
                                 KeyDown="OnNameKeyDown" />

                        <Button Grid.Column="1"
                                Content="Create"
                                MinWidth="118"
                                Margin="10,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnCreateClick" />
                    </Grid>

                    <TextBlock x:Name="CreateStatus"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="Letters, numbers, dashes and underscores only." />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="SiteList" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12"
                                Padding="18,16"
                                CornerRadius="{StaticResource RadiusMd}"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Background="#14FF6B1A"
                                        BorderBrush="#2EFF6B1A"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="18"
                                               Foreground="{StaticResource EmberBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{StaticResource FontSizeHeading}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />

                                        <Border Margin="10,0,0,0"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                CornerRadius="4"
                                                Background="#1FF87171"
                                                Visibility="{Binding MissingIndexBadge}">
                                            <TextBlock Text="NO INDEX"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F87171" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Detail}"
                                               Margin="0,5,0,0"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Open"
                                            MinWidth="96"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="OnOpenSiteClick" />
                                    <Button Content="Folder"
                                            MinWidth="96"
                                            Margin="9,0,0,0"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Click="OnOpenSiteFolderClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="EmptyState"
                    Visibility="Collapsed"
                    Margin="0,14,0,0"
                    Padding="18,16"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <TextBlock TextWrapping="Wrap"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="No project folders in this root yet. Create one above, or copy an existing project into it." />
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>