<UserControl x:Class="Emberport.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFontFamily}">

    <UserControl.Resources>
        <Style x:Key="PortBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="110" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="#FF8340" />
            <Setter Property="Background" Value="#121215" />
            <Setter Property="BorderBrush" Value="#33333C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSm}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionCheckStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Shell"
                                Padding="14,12"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="#121215"
                                BorderBrush="#33333C"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Box"
                                        Grid.Column="0"
                                        Width="20"
                                        Height="20"
                                        CornerRadius="4"
                                        Background="#1A1A1F"
                                        BorderBrush="#33333C"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="Tick"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="#FF8340"
                                               Visibility="Collapsed"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#1A1A1F" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#14FF6B1A" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#4DFF6B1A" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#4DFF6B1A" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,28,34,32">
        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="Ports, Windows startup and the configuration file. Restart a service to apply its new port." />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Recheck"
                        MinWidth="104"
                        Margin="16,4,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnRecheckClick" />
            </Grid>

            <Border Margin="0,26,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Ports"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Apache"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 x:Name="ApachePortBox"
                                 MaxLength="5"
                                 Style="{StaticResource PortBoxStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   x:Name="ApachePortStatus"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="MySQL"
                                   Margin="0,14,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 x:Name="MySqlPortBox"
                                 Margin="0,14,0,0"
                                 MaxLength="5"
                                 Style="{StaticResource PortBoxStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   x:Name="MySqlPortStatus"
                                   Margin="14,14,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Redis"
                                   Margin="0,14,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 x:Name="RedisPortBox"
                                 Margin="0,14,0,0"
                                 MaxLength="5"
                                 Style="{StaticResource PortBoxStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="2"
                                   x:Name="RedisPortStatus"
                                   Margin="14,14,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Content="Save"
                                MinWidth="120"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnSaveClick" />
                        <Button Content="Reset to defaults"
                                MinWidth="150"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnResetClick" />
                        <TextBlock x:Name="SaveStatus"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Windows startup"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,9,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Emberport can launch when you sign in to Windows. It opens straight into the notification area, so nothing appears on screen. Servers are not started automatically." />

                    <CheckBox x:Name="StartupCheck"
                              Margin="0,16,0,0"
                              HorizontalAlignment="Left"
                              Style="{StaticResource OptionCheckStyle}"
                              Content="Start Emberport when I sign in to Windows"
                              Click="OnStartupClick" />

                    <TextBlock x:Name="StartupStatus"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Configuration file"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,9,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Everything on this page is stored in a plain JSON file you can edit by hand." />
                    <Border Margin="0,14,0,0"
                            Padding="13,11"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#121215"
                            BorderBrush="#33333C"
                            BorderThickness="1">
                        <TextBlock x:Name="SettingsFilePath"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="#FF8340" />
                    </Border>
                    <Button Content="Open config folder"
                            MinWidth="160"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="OnOpenConfigClick" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>