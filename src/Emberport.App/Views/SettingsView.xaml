<UserControl x:Class="Emberport.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFontFamily}">

    <UserControl.Resources>
        <Style x:Key="PortBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="110" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="#FF8340" />
            <Setter Property="Background" Value="#121215" />
            <Setter Property="BorderBrush" Value="#33333C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusSm}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,28,34,32">
        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="Change the ports Emberport uses. Restart a service to apply its new port." />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Recheck"
                        MinWidth="104"
                        Margin="16,4,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnRecheckClick" />
            </Grid>

            <Border Margin="0,26,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>

                    <TextBlock Text="Ports"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Apache"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 x:Name="ApachePortBox"
                                 MaxLength="5"
                                 Style="{StaticResource PortBoxStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   x:Name="ApachePortStatus"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="MySQL"
                                   Margin="0,14,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 x:Name="MySqlPortBox"
                                 Margin="0,14,0,0"
                                 MaxLength="5"
                                 Style="{StaticResource PortBoxStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="2"
                                   x:Name="MySqlPortStatus"
                                   Margin="14,14,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Redis"
                                   Margin="0,14,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 x:Name="RedisPortBox"
                                 Margin="0,14,0,0"
                                 MaxLength="5"
                                 Style="{StaticResource PortBoxStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="2"
                                   x:Name="RedisPortStatus"
                                   Margin="14,14,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Content="Save"
                                MinWidth="120"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnSaveClick" />
                        <Button Content="Reset to defaults"
                                MinWidth="150"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnResetClick" />
                        <TextBlock x:Name="SaveStatus"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Configuration file"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock Margin="0,9,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Everything on this page is stored in a plain JSON file you can edit by hand." />

                    <Border Margin="0,14,0,0"
                            Padding="13,11"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#121215"
                            BorderBrush="#33333C"
                            BorderThickness="1">
                        <TextBlock x:Name="SettingsFilePath"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="#FF8340" />
                    </Border>

                    <Button Content="Open config folder"
                            MinWidth="160"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="OnOpenConfigClick" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>