<UserControl x:Class="Emberport.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,28,34,32">
        <StackPanel>

            <StackPanel>
                <TextBlock Text="About" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Version, credits and the details you need when reporting a problem."
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- Identity -->
            <Border Margin="0,24,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="52"
                            Height="52"
                            VerticalAlignment="Top"
                            CornerRadius="{StaticResource RadiusMd}"
                            Background="{StaticResource EmberGradientBrush}">
                        <TextBlock Text="&#xE945;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="#0E0E10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Emberport"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="DEPLOY. MANAGE. IGNITE."
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FF8340" />
                        <TextBlock x:Name="SignatureText"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Margin="16,2,0,0"
                            Padding="11,5"
                            VerticalAlignment="Top"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#14FF6B1A"
                            BorderBrush="#4DFF6B1A"
                            BorderThickness="1">
                        <TextBlock x:Name="VersionBadgeText"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FF8340" />
                    </Border>
                </Grid>
            </Border>

            <!-- Project -->
            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Project"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Emberport is free and open source. A star on GitHub is the easiest way to support it, and issues or ideas are always welcome."
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <Border Margin="0,14,0,0"
                            Padding="13,11"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#121215"
                            BorderBrush="#33333C"
                            BorderThickness="1">
                        <TextBlock x:Name="RepositoryText"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   Foreground="#FF8340"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Star on GitHub"
                                MinWidth="140"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnStarClick" />
                        <Button Content="Report an issue"
                                MinWidth="132"
                                Margin="9,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnIssueClick" />
                        <Button Content="Open repository"
                                MinWidth="136"
                                Margin="9,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnRepositoryClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- System information -->
            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="System information"
                                       FontSize="{StaticResource FontSizeHeading}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Paste this into a bug report so the problem can be reproduced."
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Copy diagnostics"
                                MinWidth="146"
                                Margin="16,0,0,0"
                                VerticalAlignment="Top"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnCopyClick" />
                    </Grid>

                    <ItemsControl x:Name="SystemList" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="15,9"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Background="#121215"
                                        BorderBrush="#33333C"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="StatusText"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Credits -->
            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Credits and licence"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Emberport itself is released under the MIT licence. It does not ship any server binaries. Every tool below keeps its own licence and is downloaded by you from its official website."
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <Border Margin="0,14,0,0"
                            Padding="14,12"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#0B0B0D"
                            BorderBrush="#232329"
                            BorderThickness="1">
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}">
                            Apache HTTP Server &#8212; apachelounge.com<LineBreak />
                            PHP for Windows &#8212; windows.php.net<LineBreak />
                            MySQL Community Server &#8212; dev.mysql.com<LineBreak />
                            Redis for Windows &#8212; github.com/tporadowski/redis<LineBreak />
                            phpMyAdmin &#8212; phpmyadmin.net
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>