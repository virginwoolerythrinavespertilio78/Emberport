<UserControl x:Class="Emberport.Views.ApacheView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Emberport.Controls"
             FontFamily="{StaticResource UiFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,28,34,32">
        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Apache" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="Inspect the generated configuration before the server has a chance to fail silently." />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        MinWidth="104"
                        Margin="16,4,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnRefreshClick" />
            </Grid>

            <Border Margin="0,24,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Server"
                                   FontSize="{StaticResource FontSizeHeading}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <Border Grid.Column="1"
                                x:Name="StateBadge"
                                Padding="10,5"
                                CornerRadius="4"
                                Background="#1FF87171">
                            <TextBlock x:Name="StateText"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#F87171"
                                       Text="STOPPED" />
                        </Border>
                    </Grid>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Version" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock x:Name="VersionText"
                                   Margin="0,3,0,0"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <TextBlock Text="Listening on" Margin="0,12,0,0" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock x:Name="PortText"
                                   Margin="0,3,0,0"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   Foreground="#FF8340" />

                        <TextBlock Text="Document root" Margin="0,12,0,0" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock x:Name="RootText"
                                   Margin="0,3,0,0"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <TextBlock Text="Configuration file" Margin="0,12,0,0" FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock x:Name="ConfigText"
                                   Margin="0,3,0,0"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Test configuration"
                                MinWidth="160"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnTestClick" />
                        <Button Content="Restart"
                                MinWidth="112"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnRestartClick" />
                        <Button Content="Open config"
                                MinWidth="128"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnOpenConfigClick" />
                        <Button Content="Open logs"
                                MinWidth="118"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnOpenLogsClick" />
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <controls:VersionPicker Kind="Apache" Margin="0,14,0,0" />

            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Check result"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <Border Margin="0,12,0,0"
                            Padding="14,12"
                            MinHeight="120"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#0B0B0D"
                            BorderBrush="#232329"
                            BorderThickness="1">
                        <TextBox x:Name="ResultBox"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 FontFamily="{StaticResource MonoFontFamily}"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxHeight="240"
                                 Text="Press Test configuration to run Apache's own syntax check." />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>