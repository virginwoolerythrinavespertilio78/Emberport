<UserControl x:Class="Emberport.Views.PhpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFontFamily}">

    <UserControl.Resources>
        <Style x:Key="ExtensionChipStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,9,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chip"
                                Padding="11,8"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="#121215"
                                BorderBrush="#33333C"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box"
                                        Width="16" Height="16"
                                        CornerRadius="3"
                                        Background="Transparent"
                                        BorderBrush="#4A4A55"
                                        BorderThickness="1">
                                    <TextBlock x:Name="Tick"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="9"
                                               Foreground="#0E0E10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Margin="9,0,0,0"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource EmberBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#4DFF6B1A" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#1A1A1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,28,34,32">
        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PHP" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="Pick the version Apache runs with. Switching restarts Apache automatically." />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Rescan"
                        MinWidth="104"
                        Margin="16,4,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnRescanClick" />
            </Grid>

            <ItemsControl x:Name="VersionList" Margin="0,26,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12"
                                Padding="18,16"
                                CornerRadius="{StaticResource RadiusMd}"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Background="#14FF6B1A"
                                        BorderBrush="#2EFF6B1A"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE943;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="18"
                                               Foreground="{StaticResource EmberBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="{StaticResource FontSizeHeading}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />

                                        <Border Margin="10,0,0,0"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                CornerRadius="4"
                                                Background="#1F3DD68C"
                                                Visibility="{Binding ActiveBadge}">
                                            <TextBlock Text="ACTIVE"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="#3DD68C" />
                                        </Border>

                                        <Border Margin="8,0,0,0"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                CornerRadius="4"
                                                Background="#1FF87171"
                                                Visibility="{Binding IncompatibleBadge}">
                                            <TextBlock Text="NTS · NOT SUPPORTED"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F87171" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Location}"
                                               Margin="0,5,0,0"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextTertiaryBrush}" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="Use this version"
                                        MinWidth="140"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Visibility="{Binding SwitchAction}"
                                        Click="OnUseVersionClick" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="EmptyState"
                    Visibility="Collapsed"
                    Margin="0,26,0,0"
                    Padding="18,16"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <TextBlock TextWrapping="Wrap"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="No PHP build was found. Drop an extracted x64 Thread Safe build into the bin\php folder and press Rescan." />
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Extensions"
                                       FontSize="{StaticResource FontSizeHeading}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="ExtensionSubtitle"
                                       Margin="0,7,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Restart Apache"
                                MinWidth="140"
                                Margin="16,0,0,0"
                                VerticalAlignment="Top"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnRestartApacheClick" />
                    </Grid>

                    <ItemsControl x:Name="ExtensionList" Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource ExtensionChipStyle}"
                                          Content="{Binding Name}"
                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                          Checked="OnExtensionToggled"
                                          Unchecked="OnExtensionToggled" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="ExtensionStatus"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />

                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Add another version"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock Margin="0,9,0,0"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        Download the zip archive of any PHP release, extract the whole folder,
                        and drop it into the folder below. The list refreshes every time you open
                        this page, or you can press Rescan.
                        <LineBreak /><LineBreak />
                        The build must be
                        <Run FontWeight="SemiBold" Foreground="#F2F2F5">x64</Run> and
                        <Run FontWeight="SemiBold" Foreground="#F2F2F5">Thread Safe</Run>.
                        A build marked NTS has no Apache module and cannot be selected.
                    </TextBlock>

                    <Border Margin="0,16,0,0"
                            Padding="13,11"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#121215"
                            BorderBrush="#33333C"
                            BorderThickness="1">
                        <TextBlock x:Name="PhpFolderPath"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="#FF8340" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Open PHP folder"
                                MinWidth="146"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnOpenFolderClick" />
                        <Button Content="Download builds"
                                MinWidth="146"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnDownloadClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>