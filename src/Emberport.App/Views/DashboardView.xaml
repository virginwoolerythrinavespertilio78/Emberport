<UserControl x:Class="Emberport.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,28,32,32" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Dashboard" />
                    <TextBlock x:Name="SummaryLabel" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Rescan"
                        MinWidth="104"
                        VerticalAlignment="Top"
                        Margin="16,4,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnRefreshClick" />
            </Grid>

            <Border Margin="0,20,0,0"
                    Padding="14,10"
                    HorizontalAlignment="Left"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="&#xE943;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource EmberBrush}" />

                    <TextBlock Text="ACTIVE PHP"
                               Margin="11,0,0,0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}" />

                    <Border Margin="11,0,0,0"
                            Padding="9,3"
                            CornerRadius="{StaticResource RadiusPill}"
                            Background="#14FF6B1A"
                            BorderBrush="#2EFF6B1A"
                            BorderThickness="1">
                        <TextBlock x:Name="ActivePhpText"
                                   Text="—"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FF8340" />
                    </Border>

                </StackPanel>
            </Border>

            <ItemsControl x:Name="ServiceList" Margin="0,26,0,0" />

            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>

                    <TextBlock Text="Quick links"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock x:Name="SiteUrlText"
                               Margin="0,7,0,0"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Open website"
                                MinWidth="140"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnOpenSiteClick" />
                        <Button Content="phpMyAdmin"
                                MinWidth="140"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnOpenPhpMyAdminClick" />
                        <Button Content="Open www folder"
                                MinWidth="150"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnOpenWwwClick" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>