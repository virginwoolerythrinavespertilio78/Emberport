<UserControl x:Class="Emberport.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="32,28,32,32" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Dashboard" />
                    <TextBlock x:Name="SummaryLabel" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Rescan"
                        MinWidth="104"
                        VerticalAlignment="Top"
                        Margin="16,4,0,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnRefreshClick" />
            </Grid>

            <Border Margin="0,18,0,0"
                    Padding="6,6,18,6"
                    HorizontalAlignment="Left"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">

                    <Border Width="32"
                            Height="32"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#1AFF6B1A">
                        <TextBlock Text="&#xE943;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource EmberBrush}" />
                    </Border>

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE PHP"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock x:Name="ActivePhpText"
                                   Text="—"
                                   Margin="0,1,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                </StackPanel>
            </Border>

            <ItemsControl x:Name="ServiceList" Margin="0,24,0,0" />

            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>

                    <TextBlock Text="Quick links"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock x:Name="SiteUrlText"
                               Margin="0,7,0,0"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Open website"
                                MinWidth="140"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnOpenSiteClick" />
                        <Button Content="phpMyAdmin"
                                MinWidth="140"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnOpenPhpMyAdminClick" />
                        <Button Content="Open www folder"
                                MinWidth="150"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnOpenWwwClick" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>