<UserControl
    x:Class="Emberport.Views.PlaceholderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border
            Width="72"
            Height="72"
            HorizontalAlignment="Center"
            Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe MDL2 Assets"
                FontSize="28"
                Foreground="{StaticResource EmberBrush}"
                Text="{Binding Glyph, ElementName=Root}" />
        </Border>

        <TextBlock
            Margin="0,20,0,0"
            HorizontalAlignment="Center"
            FontSize="{StaticResource FontSizeTitle}"
            FontWeight="SemiBold"
            Foreground="{StaticResource TextPrimaryBrush}"
            Text="{Binding Title, ElementName=Root}" />

        <TextBlock
            Margin="0,8,0,0"
            MaxWidth="380"
            HorizontalAlignment="Center"
            FontSize="{StaticResource FontSizeBody}"
            Foreground="{StaticResource TextSecondaryBrush}"
            Text="{Binding Description, ElementName=Root}"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <Border
            Margin="0,20,0,0"
            Padding="12,5"
            HorizontalAlignment="Center"
            Background="{StaticResource SurfaceOverlayBrush}"
            CornerRadius="{StaticResource RadiusPill}">
            <TextBlock
                FontSize="{StaticResource FontSizeCaption}"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="COMING SOON" />
        </Border>
    </StackPanel>
</UserControl>