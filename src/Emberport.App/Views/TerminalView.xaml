<UserControl x:Class="Emberport.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,28,34,32">
        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Terminal" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Style="{StaticResource PageSubtitleStyle}"
                               Text="A shell where the Emberport binaries come before anything installed on the machine." />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Rescan"
                        MinWidth="104"
                        Margin="16,4,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnRescanClick" />
            </Grid>

            <Border Margin="0,24,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Start folder"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <Border Margin="0,14,0,0"
                            Padding="13,11"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#121215"
                            BorderBrush="#33333C"
                            BorderThickness="1">
                        <TextBlock x:Name="FolderText"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="#FF8340" />
                    </Border>

                    <TextBlock x:Name="FolderBadge"
                               Margin="0,9,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Open terminal"
                                MinWidth="140"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnOpenTerminalClick" />
                        <Button Content="Choose folder"
                                MinWidth="140"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnChooseFolderClick" />
                        <Button x:Name="ResetFolderButton"
                                Content="Use web root"
                                MinWidth="132"
                                Margin="10,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnResetFolderClick" />
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="On the PATH"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock x:Name="PathSubtitle"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <ItemsControl x:Name="PathList" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,7"
                                        Padding="12,9"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Background="#121215"
                                        BorderBrush="#33333C"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FF8340" />
                                        <TextBlock Text="{Binding DirectoryPath}"
                                                   Margin="0,3,0,0"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="PathEmpty"
                               Visibility="Collapsed"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#F87171"
                               Text="No binaries detected yet, so the shell opens with the plain system PATH." />
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Try these"
                               FontSize="{StaticResource FontSizeHeading}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <Border Margin="0,12,0,0"
                            Padding="14,12"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#0B0B0D"
                            BorderBrush="#232329"
                            BorderThickness="1">
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   LineHeight="21"
                                   Foreground="{StaticResource TextSecondaryBrush}">
                            php -v<LineBreak />
                            php -m<LineBreak />
                            php -S 127.0.0.1:8000<LineBreak />
                            mysql -u root -h 127.0.0.1<LineBreak />
                            redis-cli ping<LineBreak />
                            where php
                        </TextBlock>
                    </Border>

                    <TextBlock Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeBody}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="The PATH is built for that window only, so the system environment is never modified." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>