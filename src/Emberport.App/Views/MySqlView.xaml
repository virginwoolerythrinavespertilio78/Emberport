<UserControl x:Class="Emberport.Views.MySqlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Emberport.Controls"
             FontFamily="{StaticResource UiFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,28,34,32">
        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="MySQL" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Database server, phpMyAdmin and version switching."
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Rescan"
                        MinWidth="104"
                        Margin="16,4,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnRefreshClick" />
            </Grid>

            <!-- Server -->
            <Border Margin="0,24,0,0"
                    Padding="20,18"
                    CornerRadius="{StaticResource RadiusMd}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Server"
                                       FontSize="{StaticResource FontSizeHeading}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="VersionText"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource FontSizeBody}"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <Border x:Name="StateBadge"
                                Grid.Column="1"
                                Margin="16,2,0,0"
                                Padding="11,5"
                                VerticalAlignment="Top"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="#2A1D1D">
                            <TextBlock x:Name="StateText"
                                       Text="Stopped"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#F87171" />
                        </Border>
                    </Grid>

                    <TextBlock Text="Connection"
                               Margin="0,18,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                    <Border Margin="0,7,0,0"
                            Padding="13,11"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#121215"
                            BorderBrush="#33333C"
                            BorderThickness="1">
                        <TextBlock x:Name="ConnectionText"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   Foreground="#FF8340"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <TextBlock Text="Data folder"
                               Margin="0,14,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                    <Border Margin="0,7,0,0"
                            Padding="13,11"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#121215"
                            BorderBrush="#33333C"
                            BorderThickness="1">
                        <TextBlock x:Name="DataText"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   Foreground="#FF8340"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <TextBlock Text="Configuration file"
                               Margin="0,14,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                    <Border Margin="0,7,0,0"
                            Padding="13,11"
                            CornerRadius="{StaticResource RadiusSm}"
                            Background="#121215"
                            BorderBrush="#33333C"
                            BorderThickness="1">
                        <TextBlock x:Name="ConfigText"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   Foreground="#FF8340"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Open phpMyAdmin"
                                MinWidth="150"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnOpenPhpMyAdminClick" />
                        <Button Content="Open my.ini"
                                MinWidth="112"
                                Margin="9,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnOpenConfigClick" />
                        <Button Content="Open data folder"
                                MinWidth="132"
                                Margin="9,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnOpenDataClick" />
                        <Button Content="Open error log"
                                MinWidth="126"
                                Margin="9,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnOpenLogClick" />
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Version switching -->
            <controls:VersionPicker Kind="MySql" Margin="0,14,0,0" />

            <!-- Health check, kept last so its results never push other cards around -->
            <controls:ServiceHealthCard Kind="MySql" Margin="0,14,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>